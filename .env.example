# Copy to .env.local and fill in your own values. Never commit the filled-in file.

# Anthropic — symptom extraction, SBAR generation, Kardia PDF reading
ANTHROPIC_API_KEY=
# Optional; omit to use the built-in default model
ANTHROPIC_MODEL=

# ElevenLabs — conversational voice agent
ELEVENLABS_API_KEY=

# Supabase — synthetic patient + check-in storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio — outbound voice calls
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ElevenLabs — agent telephony
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# Demo contacts
DEMO_PATIENT_PHONE=
DEMO_CAREGIVER_PHONE=

# Webhook authentication
TRIAGE_WEBHOOK_SECRET=
