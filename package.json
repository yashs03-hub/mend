{
  "name": "mend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "posttest": "tsx scripts/export-vignettes.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "vignettes": "tsx scripts/export-vignettes.ts",
    "generate:data": "tsx --env-file-if-exists=.env.local scripts/generate-dataset.ts",
    "eval:data": "tsx --env-file-if-exists=.env.local scripts/evaluate-dataset.ts",
    "evidence": "tsx --env-file-if-exists=.env.local scripts/pull-evidence.ts",
    "evidence:elicit": "tsx --env-file-if-exists=.env.local scripts/pull-evidence-elicit.ts",
    "abstracts": "tsx --env-file-if-exists=.env.local scripts/fetch-abstracts.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@base-ui/react": "^1.6.0",
    "@supabase/supabase-js": "^2.110.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.26.0",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.0",
    "shadcn": "^4.14.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
